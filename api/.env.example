PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/smartbiz_db

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS
CLIENT_URL=http://localhost:5173


#API_KEYS
SMARTBIZ_GEMINI_API_KEY=smartbiz_gemini_api_key_here

# Contact form email (SMTP). Without these, messages are logged, not emailed.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<your gmail>, SMTP_PASS=<16-char app password from Google account>.
CONTACT_TO=nuby.chartine@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
