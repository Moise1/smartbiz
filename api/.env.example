PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/smartbiz_db

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS
CLIENT_URL=http://localhost:5173


#API_KEYS
SMARTBIZ_GEMINI_API_KEY=smartbiz_gemini_api_key_here

# Email delivery. Two options, in priority order:
#
# 1) Brevo HTTP API — REQUIRED on hosts that block outbound SMTP (e.g. Render's
#    free tier, which times out on port 465). Sends over HTTPS. Sign up at
#    brevo.com, verify a sender email, create an API key:
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER=your-verified-sender@gmail.com
#
# 2) SMTP (works great locally). For Gmail: host smtp.gmail.com, port 465,
#    secure true, user = your gmail, pass = 16-char Google App Password.
CONTACT_TO=nuby.chartine@gmail.com

BREVO_API_KEY=<brevo_api_key_here>
BREVO_SENDER=<sender_email_here>
