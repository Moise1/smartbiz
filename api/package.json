{
  "name": "smartbiz-api",
  "version": "1.0.0",
  "description": "SmartBiz: An AI-Powered Platform for Discovering and Promoting Local Small Businesses",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "nodemon src/index.js",
    "dev:client": "cd ../client && npm run dev -- --port 5000",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.12.0",
    "rwanda": "^3.0.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.4"
  }
}
